{
  "name": "sketchbook-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A personal, offline drawing-practice PWA for one pen-and-ink sketcher.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "node scripts/build-artifact.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/generate-assets.mjs",
    "simulate": "tsx scripts/simulate-palette.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
